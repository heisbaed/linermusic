<resources>
    <!-- Android owns the first window. CineSplashView continues the brand reveal
         while the application renders and dismisses when the app is ready. -->
    <style name="Theme.CineMusic.Starting" parent="AppTheme">
        <item name="android:windowBackground">@drawable/cine_pre_splash</item>
        <item name="android:windowSplashScreenBackground">@color/cine_startup_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_cine_splash</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/cine_osborne_branding_text</item>
        <item name="android:windowSplashScreenAnimationDuration">840</item>
    </style>
    <style name="CineSplashBlue" parent="Theme.CineMusic.Starting" />
    <style name="CineSplashGreen" parent="Theme.CineMusic.Starting" />
    <style name="CineSplashLight" parent="Theme.CineMusic.Starting" />
    <style name="CineSplashDark" parent="Theme.CineMusic.Starting" />
    <style name="CineSplashPink" parent="Theme.CineMusic.Starting" />
</resources>
