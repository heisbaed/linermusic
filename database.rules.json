{
  "rules": {
    ".read": false,
    ".write": false,
    "analytics": {
      "$surface": {
        "events": {
          ".read": "auth != null && auth.token.email === 'charlesbabuu0@gmail.com'",
          ".indexOn": ["timestamp"],
          "$eventId": {
            ".write": "!data.exists() && newData.exists() && $surface.matches(/^(mobile|tv|landing)$/)",
            ".validate": "newData.hasChildren(['id','name','surface','path','timestamp','sessionId','device','platform','schemaVersion','installId'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().matches(/^(app_open|app_install|session_start|session_heartbeat|session_end|page_view|search|play|pause|resume|skip|complete|download_start|download_complete|download_failed|playlist_add|lyrics_view|radio_open|radio_play|connect_pair|connect_select|theme_change|sign_in|sign_out|ota_check|apk_download)$/)"
            },
            "surface": {
              ".validate": "newData.isString() && newData.val() === $surface"
            },
            "path": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() > 1577836800000 && newData.val() <= now + 300000"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "device": {
              ".validate": "newData.isString() && newData.val().matches(/^(mobile|tablet|desktop)$/)"
            },
            "platform": {
              ".validate": "newData.isString() && newData.val().matches(/^(android|android-tv|web)$/)"
            },
            "schemaVersion": {
              ".validate": "newData.isNumber() && newData.val() === 2"
            },
            "installId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "version": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "durationMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000"
            },
            "mediaPositionMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "tvLinkV2": {
      "$id": {
        ".read": "$id.matches(/^[a-f0-9]{32}$/) && (!data.exists() || data.child('expiresAt').val() > now)",
        ".write": "$id.matches(/^[a-f0-9]{32}$/) && !data.exists() && newData.exists() && !newData.child('reply').exists()",
        ".validate": "newData.hasChildren(['expiresAt', 'n', 'e'])",
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 330000"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{342}$/)"
        },
        "e": {
          ".validate": "newData.val() === 'AQAB'"
        },
        "reply": {
          ".write": "auth != null && auth.token.email_verified === true && !data.exists() && newData.child('uid').val() === auth.uid && data.parent().child('expiresAt').val() > now",
          ".validate": "newData.hasChildren(['uid', 'key', 'iv', 'data'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().length === 344"
          },
          "iv": {
            ".validate": "newData.isString() && newData.val().length === 16"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length <= 4096"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tvSearchV2": {
      "$id": {
        ".write": "auth != null && auth.token.email_verified === true && $id.matches(/^[a-f0-9]{32}$/) && ((!data.exists() && newData.child('uid').val() === auth.uid && !newData.child('query').exists()) || (data.child('uid').val() === auth.uid && !newData.exists()))",
        ".read": "auth != null && auth.uid === data.child('uid').val() && data.child('expiresAt').val() > now",
        ".validate": "newData.hasChildren(['uid','expiresAt'])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 330000"
        },
        "query": {
          ".write": "auth != null && auth.token.email_verified === true && auth.uid === data.parent().child('uid').val() && data.parent().child('expiresAt').val() > now && newData.exists()",
          ".validate": "newData.hasChildren(['text','id'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
